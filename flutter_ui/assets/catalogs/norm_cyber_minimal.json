 "questions": [
  {
   "code": "q_cym_1",
   "type": "SELECT",
   "domain": "CYBER",
   "text": "Cyberrelevante Komponenten und Schnittstellen erfassen — Sollzustand: Alle sicherheitsrelevanten Komponenten und alle kabelgebundenen, kabellosen, dauerhaften und temporären Datenschnittstellen sind erfasst (Steuerung/PESSRAL, Frequenzumrichter/STO, Türsteuergerät, Notruf, Router/Modem/Gateway/Fernwartung, Schnittstellen zu BMA/GLT/Zutritt/Entrauchung, Serviceanschlüsse/USB/Speicherkarten/ WLAN/Bluetooth/mobile Servicegeräte). Sind keine kompromittierbaren Schnittstellen vorhanden, ist dies ausdrücklich begründet. „Kein Internetanschluss\" allein genügt nicht.",
   "category": "Cybersicherheit (TRBS 1115-1)",
   "options": [
    {
     "value": "erfuellt",
     "label": "Anforderung erfüllt"
    },
    {
     "value": "teilweise",
     "label": "Teilweise erfüllt"
    },
    {
     "value": "nicht_erfuellt",
     "label": "Nicht erfüllt"
    },
    {
     "value": "na",
     "label": "Nicht anwendbar (begründet)"
    }
   ]
  },
  {
   "code": "q_cym_2",
   "type": "SELECT",
   "domain": "CYBER",
   "text": "Sicherheitsauswirkungen bewerten — Sollzustand: Für jede relevante Komponente ist bewertet, ob Manipulation, Fehlkonfiguration, Kommunikationsstörung oder Ausfall eine Gefährdung von Personen verursachen kann: unzulässige Fahrbewegung/ Geschwindigkeit, Fehlbündigkeit, Türbewegung/Türkräfte, Ausfall/ Manipulation von Sicherheitsfunktionen, unzulässige Parameter- änderung, Ausfall/Umleitung des Notrufs, Einschluss von Personen, fehlerhaftes Brandfall-/Evakuierungsverhalten.",
   "category": "Cybersicherheit (TRBS 1115-1)",
   "options": [
    {
     "value": "erfuellt",
     "label": "Anforderung erfüllt"
    },
    {
