# GBU 4.0 Engine-API – Umgebungsvariablen (Beispiel)
#
# Auf Railway wird DATABASE_URL vom Postgres-Service bereitgestellt (Referenz
# setzen, siehe README). Lokal die public URL des Railway-Postgres eintragen.

# Verbindungs-String zur Datenbank.
#   Railway intern:  postgresql://postgres:PASS@postgres.railway.internal:5432/railway   (ohne SSL, automatisch erkannt)
#   Railway public:  postgresql://postgres:PASS@HOST.proxy.rlwy.net:PORT/railway         (mit SSL, automatisch)
DATABASE_URL=

# Ziel-Schema der Engine. Default 'gbu', sobald DATABASE_URL gesetzt ist –
# hält die Engine getrennt von bestehenden Tabellen in derselben Datenbank.
# PGSCHEMA=gbu

# SSL erzwingen aus (nur nötig, falls die Auto-Erkennung nicht passt).
# PGSSL=off

# Selbst-Seed beim Start:
#   (leer/default) Schema anlegen + Kataloge laden, falls unvollständig.
#   off    kein Selbst-Seed.
#   force  Kataloge bei JEDEM Start neu einspielen (Upsert) – nötig, um in einer
#          bestehenden DB geänderte Regeln (z. B. Risikostufen) zu aktualisieren.
# SEED_ON_BOOT=force

# Port (Railway setzt PORT selbst; lokal Default 8787).
# PORT=8787
