  "rules": [
    {
      "hazard": "M032", "code": "M032-R001", "priority": 100,
      "condition": { "question": "q_emergency_call_present", "operator": "EQ", "value": false },
      "result": "HIGH",
      "evidence": "DIRECT", "origin": "RECONSTRUCTED_ORIGINAL", "quality_status": "REVIEW_REQUIRED",
      "measures": [ { "measure": "m_emergency_call_install", "relation": "SINGLE", "mandatory": true } ],
      "sources": [ { "type": "TRBS", "document": "TRBS 3121" }, { "type": "EN", "document": "EN 81-28" } ],
      "notes": "Original: f033=Nein -> HOCH; f189/f211 ohne eigenen Risikobeitrag. REVIEW_REQUIRED, weil vorhandener, aber nicht aufgeschalteter/nicht EN-81-28-konformer Notruf im Original KEIN RISIKO ergibt (fachlich fragwuerdig)."
    },
    {
      "hazard": "M032", "code": "M032-T010", "priority": 50,
      "applicability": { "question": "q_emergency_call_present", "operator": "EQ", "value": true },
      "condition": {
        "any": [
          { "question": "q_emergency_call_24h", "operator": "EQ", "value": false },
          { "question": "q_emergency_call_en8128", "operator": "EQ", "value": false }
        ]
      },
      "result": "MEDIUM",
      "evidence": "HYPOTHESIS", "origin": "OWN_RULE", "quality_status": "REVIEW_REQUIRED",
      "notes": "ZIEL-Logik (bewusste Abweichung): Notruf vorhanden, aber ohne 24h-Aufschaltung oder nicht EN-81-28-konform -> MITTEL. Erst nach normativer Pruefung aktivieren."
    },

    {
      "hazard": "MC4", "code": "MC4-R001", "priority": 100,
      "applicability": { "question": "q_ctrl_digital", "operator": "EQ", "value": true },
      "condition": {
        "all": [
          { "question": "q_ctrl_free_access", "operator": "EQ", "value": true },
          { "any": [
            { "question": "q_ctrl_wireless", "operator": "EQ", "value": true },
            { "question": "q_ctrl_physical", "operator": "EQ", "value": true }
          ] }
        ]
      },
      "result": "MEDIUM",
      "evidence": "HIGH_CONFIDENCE", "origin": "RECONSTRUCTED_ORIGINAL", "quality_status": "VERIFIED",
      "sources": [ { "type": "TRBS", "document": "TRBS 1115 Teil 1" } ],
      "notes": "Bauplan MC4-MC9. ODER zwischen Drahtlos/Physik. Pflicht-Sein der beiden Schnittstellenfragen liegt in hazard_questions (required_mode=ALWAYS) -> fehlt eine, INCOMPLETE statt NO_RISK."
    },

    {
      "hazard": "MC11", "code": "MC11-R001", "priority": 100,
      "condition": { "question": "q_attendant_module", "operator": "EQ", "value": true },
